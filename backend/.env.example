# Copia este archivo a .env y rellena los valores. NUNCA subas .env a git.

# --- Acceso a la bandeja (¡OBLIGATORIO si está expuesta a internet!) ---
INBOX_USER=
INBOX_PASS=

# --- Telegram: MODO CUENTA PERSONAL (recomendado) ---
# La bandeja se conecta como un dispositivo más de tu cuenta de Telegram y
# recibe tus chats privados. Credenciales en https://my.telegram.org
# (API development tools). TELEGRAM_SESSION se genera una única vez con:
#   node scripts/telegram-login.js
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# --- Telegram: MODO BOT (alternativa; se usa solo si el modo cuenta
#     personal no está configurado) ---
TELEGRAM_BOT_TOKEN=

# --- WhatsApp Cloud API (se rellenan al llegar al bloque A2) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Servidor ---
PORT=3000

# Opcional: versión de la Graph API (por defecto v21.0)
# GRAPH_API_VERSION=v21.0

# Opcional: usar webhook de Telegram (modo bot) en vez de long polling
# TELEGRAM_USE_WEBHOOK=1
