# Copia este archivo a .env y rellena los valores. NUNCA subas .env a git.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- WhatsApp Cloud API (se rellenan al llegar al bloque A2) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Servidor ---
PORT=3000

# Opcional: versión de la Graph API (por defecto v21.0)
# GRAPH_API_VERSION=v21.0

# Opcional: usar webhook de Telegram en vez de long polling (por defecto polling)
# TELEGRAM_USE_WEBHOOK=1
